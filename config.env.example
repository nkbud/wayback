# Example configuration for Wayback MCP Server
# Copy this file and modify as needed

# Server configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000

# Rate limiting (requests per minute)
WAYBACK_RATE_LIMIT=60
LOC_RATE_LIMIT=30

# Default search limits
DEFAULT_SEARCH_LIMIT=10
MAX_SEARCH_LIMIT=100

# Timeout settings (seconds)
REQUEST_TIMEOUT=30
SEARCH_TIMEOUT=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Cache settings (if implementing caching)
CACHE_ENABLED=false
CACHE_TTL=3600

# Authority source priorities
# Higher numbers = higher priority
AUTHORITY_WEIGHTS_LIBRARY_OF_CONGRESS=10
AUTHORITY_WEIGHTS_INTERNET_ARCHIVE=8
AUTHORITY_WEIGHTS_NATIONAL_LIBRARIES=9
AUTHORITY_WEIGHTS_ACADEMIC_LIBRARIES=7